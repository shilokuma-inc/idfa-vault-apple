//
//  Project.xcconfig
//  IDFAVault
//
//  プロジェクト共通のビルド設定。
//  テンプレートから新規リポジトリを作成したら、まずこのファイルの値を書き換える。
//  （pbxproj 側にはこれらの値を直接書かず、ここだけを編集する）
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.IDFAVault

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.1.0
// ビルド番号の起点。Upload は Xcode の自動採番で、新しいバージョンではこの値から数え直す。
// macOS はバージョンをまたいでも前のビルドより大きくしないとアップロードできないので、
// macOS の前のバージョンの最後のビルド番号より大きくしておく（1.0.0 の macOS は 12 まで）
CURRENT_PROJECT_VERSION = 13

// 最低サポート OS（iOS と iPadOS・macOS・visionOS の 1 ターゲット）
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
XROS_DEPLOYMENT_TARGET = 1.0

// macOS の entitlements。iCloud（CloudKit）は provisioning profile が要る entitlement で、profile の無いアドホック署名で付けると
// 起動時にシステムに止められる。CI のテストと archive のアドホック署名では IDFAVAULT_ADHOC_SIGNING=YES を渡し、iCloud を付けない。
// それ以外（Xcode の自動の署名・profile を指定した手動の署名）では付ける。配布（TestFlight・App Store）の archive には、
// _archive.yml が archive の後に Tools/embed_archive_entitlements.py で足す。iOS・visionOS は pbxproj で常に付ける
IDFAVAULT_ADHOC_SIGNING = NO
IDFAVAULT_MACOS_ENTITLEMENTS_NO = IDFAVault/IDFAVault.entitlements
IDFAVAULT_MACOS_ENTITLEMENTS_YES =
